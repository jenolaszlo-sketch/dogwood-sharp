    "temporalOwner": "namespace Test { entity User; entity Item { owner: User }; action Approve appliesTo { principal: [User], resource: [Item], context: { input: { stock: String } } }; action Sell appliesTo { principal: [User], resource: [Item], context: { input: { stock: String } } }; }"
