<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DogwoodSharp</PackageId>
    <Version>0.0.0-discovery.1</Version>
    <Authors>DogwoodSharp contributors</Authors>
    <Description>Dogwood policy parsing for .NET using the pinned native Dogwood parser.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dogwood;cedar;authorization;temporal</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable Condition="'$(DogwoodSharpFoundationPack)' == 'true'">true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <InternalsVisibleTo Include="DogwoodSharp.Tests" />
    <!-- The D3 per-rule export surface stays internal: this package's public type and member
         set is a frozen qualification baseline (archived D1 consumer regression). The experimental
         CedarSharp adapter and its tests consume operation 4 through these friend assemblies,
         and the D3-IMPL-01 upstream differential probe consumes it as its production path. -->
    <InternalsVisibleTo Include="DogwoodSharp.CedarSharp" />
    <InternalsVisibleTo Include="DogwoodSharp.CedarSharp.Tests" />
    <InternalsVisibleTo Include="PrepProbe" />
    <None Include="../../README.md;../../LICENSE;../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
