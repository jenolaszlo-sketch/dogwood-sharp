        "OQ-01"
      ],
      "question": "Valid history and current entities - both sides should allow",
      "schema": "temporalOwner",
      "distincter": "oq01tc",
      "source": "permit(principal, action == Test::Action::\"Sell\", resource)\nwhen temporal { formerly within 1h Test::Action::\"Approve\"::request { input.stock: context.input.stock } };\nforbid(principal, action == Test::Action::\"Approve\", resource) when { resource.owner == principal };",
      "expectedClassification": "agreement",
