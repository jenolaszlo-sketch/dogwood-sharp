<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DogwoodSharp</PackageId>
    <Version>0.0.0-discovery.1</Version>
    <Authors>DogwoodSharp contributors</Authors>
    <Description>Dogwood policy parsing for .NET using the pinned native Dogwood parser.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dogwood;cedar;authorization;temporal</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- This project opts in explicitly; the repository-wide IsPackable=false default remains
         unchanged for every other project. The D3 native assets are mandatory package inputs. -->
    <IsPackable>true</IsPackable>
    <DogwoodSharpNativeAssetsRoot Condition="'$(DogwoodSharpNativeAssetsRoot)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native</DogwoodSharpNativeAssetsRoot>
    <DogwoodSharpPackageShell Condition="'$(DogwoodSharpPackageShell)' == ''">pwsh</DogwoodSharpPackageShell>
    <DogwoodSharpPackageShellArguments Condition="'$(DogwoodSharpPackageShellArguments)' == ''" />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <InternalsVisibleTo Include="DogwoodSharp.Tests" />
    <!-- The D3 per-rule export surface stays internal: this package's public type and member
         set is a frozen qualification baseline (archived D1 consumer regression). The experimental
         CedarSharp adapter and its tests consume operation 4 through these friend assemblies,
         and the D3-IMPL-01 upstream differential probe consumes it as its production path. -->
    <InternalsVisibleTo Include="DogwoodSharp.CedarSharp" />
    <InternalsVisibleTo Include="DogwoodSharp.CedarSharp.Tests" />
    <InternalsVisibleTo Include="PrepProbe" />
    <None Include="../../README.md;../../LICENSE;../../NOTICE" Pack="true" PackagePath="/" />
    <!-- NuGet selects the matching runtime-native item and flattens it into a consuming
         application's publish root. The pack target below refuses to produce a package unless
         all three image/manifest pairs exist and match their pinned identities and hashes. -->
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/win-x64/native/dogwoodsharp_bridge.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/dogwoodsharp_bridge.dll" />
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/win-x64/native/dogwoodsharp-native.json"
          Pack="true" PackagePath="runtimes/win-x64/native/dogwoodsharp-native.json" />
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/linux-x64/native/libdogwoodsharp_bridge.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/libdogwoodsharp_bridge.so" />
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/linux-x64/native/dogwoodsharp-native.json"
          Pack="true" PackagePath="runtimes/linux-x64/native/dogwoodsharp-native.json" />
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/osx-arm64/native/libdogwoodsharp_bridge.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/libdogwoodsharp_bridge.dylib" />
    <None Include="$(DogwoodSharpNativeAssetsRoot)/runtimes/osx-arm64/native/dogwoodsharp-native.json"
          Pack="true" PackagePath="runtimes/osx-arm64/native/dogwoodsharp-native.json" />
  </ItemGroup>
  <Target Name="ValidateDogwoodNativeAssetsForPack" BeforeTargets="GenerateNuspec">
    <Exec Command='"$(DogwoodSharpPackageShell)" $(DogwoodSharpPackageShellArguments) -NoLogo -NoProfile -NonInteractive -File "$(MSBuildProjectDirectory)/../../eng/Test-NativePackageAssets.ps1" -AssetsRoot "$(DogwoodSharpNativeAssetsRoot)"' />
  </Target>
</Project>
