<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DogwoodSharp</PackageId>
    <Version>0.0.0-discovery.1</Version>
    <Authors>DogwoodSharp contributors</Authors>
    <Description>Discovery foundation for an independent .NET Dogwood policy library. No policy evaluation API is implemented.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/dogwood-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dogwood;cedar;authorization;temporal</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable Condition="'$(DogwoodSharpFoundationPack)' == 'true'">true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <AssemblyMetadata Include="DevelopmentStage" Value="DiscoveryOnly" />
    <None Include="../../README.md;../../LICENSE;../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
